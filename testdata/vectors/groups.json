      {"input": "signal.group/#CjQKIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fEhAgISIjJCUmJygpKissLS4v", "outcome": "not_a_link"},
      {"input": "not a uri %%", "outcome": "not_a_link"}
