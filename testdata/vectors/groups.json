      {"input": "https://signal.group/#CiQKEAAAAAAAAAAAAAAAAAAAAAASECAhIiMkJSYnKCkqKywtLi8", "outcome": "invalid", "message": "org.signal.libsignal.zkgroup.InvalidInputException: Length of array supplied was 16 expected 32", "note": "16-byte master key"},
      {"input": "https://signal.group/#EAE", "outcome": "unknown_version", "message": "Url contains no known group link content", "note": "bytes 10 01: unknown field 2, no contentsV1"},
      {"input": "https://signal.group/#x", "outcome": "uncaught", "message": "java.lang.IllegalArgumentException: Base64-encoded string must have at least four characters, but length specified was 1"},
      {"input": "https://example.com/#CjQKIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fEhAgISIjJCUmJygpKissLS4v", "outcome": "not_a_link"},
