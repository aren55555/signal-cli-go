      {"input": "https://signal.group/?a=b#CjQKIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fEhAgISIjJCUmJygpKissLS4v", "outcome": "ok", "master_key_hex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "password_hex": "202122232425262728292a2b2c2d2e2f", "note": "query is ignored"},
      {"input": "https://user@signal.group:443/#CjQKIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fEhAgISIjJCUmJygpKissLS4v", "outcome": "ok", "master_key_hex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "password_hex": "202122232425262728292a2b2c2d2e2f", "note": "user info and port are ignored; only scheme and host are checked"},
      {"input": "https://signal.group/#CiIKIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f", "outcome": "ok", "master_key_hex": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "password_hex": "", "note": "no password field: empty password"},
      {"input": "https://signal.group/x#CjQKIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4fEhAgISIjJCUmJygpKissLS4v", "outcome": "invalid", "message": "No path was expected in uri"},
      {"input": "https://signal.group/", "outcome": "invalid", "message": "No reference was in the uri"},
      {"input": "https://signal.group/#", "outcome": "invalid", "message": "No reference was in the uri"},
