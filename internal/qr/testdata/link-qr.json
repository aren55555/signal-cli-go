            "\u2588\u2588\u2588\u2588 \u2588\u2584\u2584\u2584\u2588 \u2588\u2580\u2584 \u2584\u2588 \u2588\u2580 \u2588\u2580\u2584\u2584\u2584\u2580\u2584\u2584\u2588  \u2584\u2588 \u2588\u2584\u2584\u2584\u2588 \u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2588\u2584\u2580\u2584\u2588\u2584\u2588 \u2580 \u2588\u2584\u2588\u2584\u2580\u2584\u2588\u2584\u2588\u2584\u2588 \u2588\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2584\u2584 \u2584\u2584\u2580\u2584  \u2584\u2588\u2580\u2588 \u2584\u2580\u2580\u2588\u2580\u2580\u2584\u2580 \u2580 \u2584\u2580\u2584\u2584 \u2588 \u2588\u2584\u2580\u2584\u2588\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2588 \u2580\u2580\u2588\u2584\u2584\u2580 \u2584\u2580\u2580\u2580\u2588\u2584\u2584 \u2588\u2584\u2580  \u2588\u2588\u2584\u2588\u2584 \u2588    \u2580\u2584\u2588\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2584\u2584\u2584\u2580\u2588\u2580\u2584\u2588 \u2580\u2584\u2584\u2584\u2580\u2584\u2588\u2580\u2584\u2588\u2580 \u2580 \u2588\u2584\u2588\u2584   \u2584\u2584\u2584\u2584 \u2580\u2588\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2580  \u2588  \u2584\u2584 \u2584\u2588\u2588\u2580\u2588\u2588 \u2588\u2584\u2588\u2588   \u2580\u2580\u2584\u2584\u2584\u2584   \u2588\u2588\u2584\u2588 \u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2580\u2580\u2584 \u2584 \u2584\u2584\u2584\u2580\u2580\u2588\u2588  \u2588 \u2584  \u2580\u2580\u2584\u2580\u2580\u2580\u2584 \u2580\u2584\u2584\u2580\u2584\u2584 \u2584\u2588\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2580  \u2584  \u2584\u2580\u2584\u2584 \u2580 \u2584\u2588\u2584\u2588\u2588\u2588\u2588\u2584\u2580\u2588\u2588\u2588\u2588\u2580\u2584\u2580\u2580\u2580\u2584\u2584\u2584\u2588\u2584\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2588\u2588 \u2588 \u2588\u2584\u2588\u2580\u2580\u2584\u2580\u2588\u2588  \u2580\u2584\u2584\u2580\u2580\u2584 \u2580 \u2584\u2580\u2580\u2580\u2584\u2584\u2580\u2584  \u2584\u2588\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2584\u2588 \u2580\u2588 \u2584\u2584 \u2584\u2584\u2588\u2588\u2584\u2584\u2584 \u2584 \u2580 \u2580 \u2588\u2580\u2584\u2588 \u2588\u2584 \u2584\u2580\u2588\u2588 \u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588  \u2580  \u2580\u2584\u2588\u2580\u2588\u2588\u2588\u2588\u2588 \u2580\u2580\u2588\u2580\u2580\u2584\u2588\u2584\u2588\u2588 \u2584\u2584\u2584\u2580\u2584\u2580\u2584\u2584 \u2584\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588 \u2588  \u2584 \u2584 \u2588 \u2588\u2588\u2584\u2584\u2588\u2584\u2588\u2584\u2580\u2588\u2588\u2580\u2580\u2580\u2584\u2584 \u2584\u2588 \u2580\u2580\u2584\u2584\u2584 \u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2584\u2588\u2588\u2588\u2588\u2584\u2584\u2588\u2580\u2584\u2584\u2584\u2584 \u2584\u2584\u2580\u2584\u2584\u2584 \u2580\u2584\u2580\u2584 \u2584\u2584 \u2584\u2584\u2584   \u2580\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588 \u2584\u2584\u2584\u2584\u2584 \u2588\u2584\u2584\u2584\u2580 \u2584  \u2588\u2588\u2580\u2580\u2588  \u2580\u2588\u2588\u2580\u2588 \u2588\u2584\u2588 \u2588\u2584\u2584\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588 \u2588   \u2588 \u2588 \u2580\u2580 \u2588 \u2584\u2584 \u2584\u2580\u2588\u2580\u2588 \u2588\u2584\u2580\u2584 \u2584    \u2584\u2584\u2588\u2588\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588 \u2588\u2584\u2584\u2584\u2588 \u2588  \u2588\u2580\u2580\u2588\u2580\u2584\u2584\u2584\u2588\u2588  \u2580\u2580\u2584\u2588\u2588\u2580 \u2580  \u2588\u2584\u2588\u2584 \u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2588\u2584\u2588\u2584\u2588\u2584\u2584\u2584\u2584\u2584\u2584\u2588\u2584\u2584\u2588\u2588\u2584\u2584\u2584\u2584\u2588\u2588\u2588\u2588\u2584\u2588\u2584\u2584\u2584\u2584\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588",
            "\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588"
         ],
